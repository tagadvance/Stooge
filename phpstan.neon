parameters:
  # Level 6 (missing type hints, iterable value types) reports 46 errors. That
  # is the next ratchet, not a regression.
  level: 5
  paths:
    - src
    - tests
  # URLQuery stores arbitrary query parameters behind __get/__set, the same way
  # stdClass does.
  universalObjectCratesClasses:
    - tagadvance\stooge\URLQuery
