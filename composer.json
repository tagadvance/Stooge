{
	"name" : "tagadvance/stooge",
	"description" : "A fluent builder around PHP's cURL extension for making HTTP requests.",
	"type" : "library",
	"keywords": ["http", "https", "curl", "client", "request", "url", "query", "cookie", "session", "webdav"],
	"license" : "MIT",
	"authors" : [{
			"name" : "Tag",
			"email" : "tagadvance+stooge@gmail.com"
		}
	],
	"require" : {
		"php" : "^8.4",
		"ext-curl": "*",
		"ext-SPL": "*"
	},
	"require-dev" : {
		"friendsofphp/php-cs-fixer" : "^3.95",
		"phpstan/phpstan" : "^2.2",
		"phpunit/phpunit" : "^13.3"
	},
	"autoload" : {
		"psr-4" : {
			"tagadvance\\" : "src/tagadvance/"
		}
	}
}
